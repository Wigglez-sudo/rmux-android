diff --git a/bin/temporary-boot.sh b/bin/temporary-boot.sh
index 081bbb7..a1f8f89 100644
--- a/bin/temporary-boot.sh
+++ b/bin/temporary-boot.sh
@@ -1,5 +1,2 @@
 #!/bin/sh
-
-find-install.sh
-sleep 2
-resume-boot
+find-install.sh && resume-boot
diff --git a/functions.sh b/functions.sh
index 706c8d1..7cdbe02 100644
--- a/functions.sh
+++ b/functions.sh
@@ -619,4 +619,117 @@ rootdelay() {
 	fi
 }
 
+ps4hdd_part() {
+	for p in /dev/sd?27; do
+		if [ -b "${p}" ]; then
+			echo "${p}"
+			return 0
+		fi
+	done
+	return 1
+}
+
+ps4hdd_open() {
+	mountpoint -q /ps4hdd && return 0
+	if ! [ -b /dev/mapper/ps4hdd ]; then
+		if ! [ -r /key/eap_hdd_key.bin ]; then
+			ewarn "No /key/eap_hdd_key.bin, the internal drive can not be opened."
+			return 1
+		fi
+		local part
+		if ! part="$(ps4hdd_part)"; then
+			ewarn "No PS4 internal drive found (no /dev/sd?27)."
+			return 1
+		fi
+		cryptsetup -d /key/eap_hdd_key.bin --cipher aes-xts-plain64 -s 256 --offset 0 --skip 111669149696 create ps4hdd "${part}" || return 1
+	fi
+	mkdir -p /ps4hdd
+	if ! mount -t ufs -o ufstype=ufs2 /dev/mapper/ps4hdd /ps4hdd; then
+		eerror "Could not mount /dev/mapper/ps4hdd on /ps4hdd."
+		return 1
+	fi
+}
+
+ps4_wait_disks() {
+	local n=0
+	while [ "${n}" -lt "${1:-8}" ]; do
+		findfs LABEL=psxitarch >/dev/null 2>&1 && return 0
+		sleep 1
+		n=$((n + 1))
+	done
+}
+
+ps4_fsck() {
+	case "$(blkid "$1" 2>/dev/null)" in
+		*'TYPE="ext'*)
+			einfo "Checking $1 ..."
+			e2fsck -p "$1"
+			if [ "$?" -ge 4 ]; then
+				ewarn "e2fsck found errors it could not fix on $1."
+				ewarn "Run 'e2fsck -f $1' by hand if the boot fails."
+			fi
+		;;
+	esac
+}
+
+ps4_find_install() {
+	if mountpoint -q /newroot && ! umount /newroot; then
+		eerror "/newroot is busy, can not search again."
+		return 1
+	fi
+	local dev
+	if dev="$(findfs LABEL=psxitarch 2>/dev/null)"; then
+		ps4_fsck "${dev}"
+		if mount "${dev}" /newroot; then
+			einfo "Mounted external installation (${dev})."
+			return 0
+		fi
+	fi
+	ewarn "External installation not found, checking internal drive..."
+	if ps4hdd_open && [ -f /ps4hdd/home/linux.img ]; then
+		ps4_fsck /ps4hdd/home/linux.img
+		if mount /ps4hdd/home/linux.img /newroot; then
+			einfo "Mounted internal installation."
+			return 0
+		fi
+	fi
+	ewarn "No installation found on internal drive either."
+	return 1
+}
+
+ps4_prepare_newroot() {
+	local d
+	for d in dev media mnt proc run sys tmp var/cache var/log var/tmp; do
+		mkdir -p "/newroot/${d}"
+	done
+}
+
+ps4_find_distro() {
+	local f
+	for f in distro.tar.xz distro.tar.gz distro.tar.bz2 distro.tar psxitarch.tar.xz; do
+		if [ -f "$1/${f}" ]; then
+			echo "$1/${f}"
+			return 0
+		fi
+	done
+	if [ -f "$1/distro.tar.zst" ]; then
+		eerror "distro.tar.zst is not supported, recompress it as distro.tar.xz."
+	fi
+	return 1
+}
+
+ps4_extract() {
+	local z=''
+	case "$1" in
+		*.xz) z='-J' ;;
+		*.gz) z='-z' ;;
+		*.bz2) z='-j' ;;
+	esac
+	set -o pipefail
+	pv -pterb -s "$(stat -c %s "$1")" "$1" | tar -x ${z} -f - -C /newroot --numeric-owner
+	local rc=$?
+	set +o pipefail
+	return "${rc}"
+}
+
 # vim: noexpandtab
diff --git a/init b/init
index a30757c..3756793 100644
--- a/init
+++ b/init
@@ -84,13 +84,17 @@ use uswsusp && UswsuspResume
 use tuxonice TuxOnIceResume
 run_hooks pre_newroot_mount
 use rootdelay rootdelay
-sleep 5
-cryptsetup -d /key/eap_hdd_key.bin --cipher aes-xts-plain64 -s 256 --offset 0 --skip 111669149696 create ps4hdd /dev/sd?27
-mkdir -p /ps4hdd
-mount -t ufs -o ufstype=ufs2 /dev/mapper/ps4hdd /ps4hdd
-sleep 3
-find-install.sh
-emount /newroot
+ps4_wait_disks 8
+if ! ps4_find_install && use root; then
+	emount /newroot
+fi
+while ! mountpoint -q /newroot; do
+	eerror "No Linux installation is mounted on /newroot."
+	ewarn "Install with 'install-linux-int.sh' (internal) or 'install-linux-ext.sh' (USB),"
+	ewarn "or run 'find-install.sh', then run 'resume-boot'."
+	rescueshell
+done
+ps4_prepare_newroot
 run_hooks after_mount_newroot
 cleanup
 moveDev
