From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Mon, 12 Oct 2026 11:12:36 +0200
Subject: [PATCH] init: open the PS4 HDD only when needed and boot after one
 resume-boot

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 bin/find-install.sh    |  15 +-----
 bin/fix-install.sh     |  19 ++-----
 bin/resume-boot        |   3 +-
 bin/start-psxitarch.sh |  11 +---
 bin/temporary-boot.sh  |   5 +-
 functions.sh           | 113 +++++++++++++++++++++++++++++++++++++++++
 init                   |  18 ++++---
 7 files changed, 134 insertions(+), 50 deletions(-)
 mode change 100644 => 120000 bin/start-psxitarch.sh

diff --git a/bin/find-install.sh b/bin/find-install.sh
index 37ffa43..fe6f8ef 100644
--- a/bin/find-install.sh
+++ b/bin/find-install.sh
@@ -1,16 +1,3 @@
 #!/bin/sh
 . /functions.sh
-umount /newroot 2>/dev/null;
-if mount LABEL=psxitarch /newroot 2>/dev/null; then
-    einfo "Mounted external installation."
-else
-    ewarn "External installation not found, checking internal drive..."
-
-    # Internal Setup
-
-    if mount /ps4hdd/home/linux.img /newroot 2>/dev/null; then
-        einfo "Mounted internal installation."
-    else
-        ewarn "No installation found on internal drive either."
-    fi
-fi
+ps4_find_install
diff --git a/bin/fix-install.sh b/bin/fix-install.sh
index 6b9eb75..af30c35 100644
--- a/bin/fix-install.sh
+++ b/bin/fix-install.sh
@@ -1,19 +1,10 @@
 #!/bin/sh
-
 . /functions.sh
 if mountpoint -q /newroot; then
-    einfo "Creating folders on /newroot..."
-    mkdir -p /newroot/dev
-    mkdir -p /newroot/media
-    mkdir -p /newroot/mnt
-    mkdir -p /newroot/proc
-    mkdir -p /newroot/run
-    mkdir -p /newroot/sys
-    mkdir -p /newroot/tmp
-    mkdir -p /newroot/var/cache
-    mkdir -p /newroot/var/log
-    mkdir -p /newroot/var/tmp
-    einfo "Done!"
+	einfo "Creating folders on /newroot..."
+	ps4_prepare_newroot
+	einfo "Done!"
 else
-    eerror "/newroot is not a mountpoint, please reboot."
