diff --git a/bin/resume-boot b/bin/resume-boot
index 74bead5..513fd5b 100644
--- a/bin/resume-boot
+++ b/bin/resume-boot
@@ -35,6 +35,7 @@ if mountpoint -q /newroot; then
     if [ -f '/rescueshell.pid' ]; then kill -9 "$(cat /rescueshell.pid)"; fi
 else
     . /functions.sh
-    eerror "/newroot is not a mountpoint, please reboot."
+    eerror "/newroot is not a mountpoint, run find-install.sh first."
+    exit 1
 fi
 #if [ -f '/remote-rescueshell.lock' ]; then rm '/remote-rescueshell.lock'; fi
diff --git a/bin/start-psxitarch.sh b/bin/start-psxitarch.sh
deleted file mode 100644
index c8e4dc5..0000000
--- a/bin/start-psxitarch.sh
+++ /dev/null
@@ -1,10 +0,0 @@
-#!/bin/sh
-
-mount LABEL=psxitarch /newroot
-
-echo "Booting psxitarch linux, please wait.." 
-exec switch_root /newroot /newroot/sbin/init &
-sleep 2 &&
-exec switch_root /newroot /newroot/sbin/init &
-sleep 2 &&
-exec switch_root /newroot /newroot/sbin/init
