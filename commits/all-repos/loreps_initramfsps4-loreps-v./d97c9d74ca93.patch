From d97c9d74ca933df8951b7acebbd15438565c72da Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Mon, 12 Oct 2026 11:12:36 +0200
Subject: [PATCH] profile: source profile.d files without the exec bit

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 etc/profile                 | 2 +-
 etc/profile.d/00_profile.sh | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/etc/profile b/etc/profile
index 1430917..f4cc8bb 100644
--- a/etc/profile
+++ b/etc/profile
@@ -1,7 +1,7 @@
 #!/bin/sh
 
 for f in /etc/profile.d/*.sh; do
-	if [ -x "$f" ]; then
+	if [ -r "$f" ]; then
 		. $f
 	fi
 done; unset f
diff --git a/etc/profile.d/00_profile.sh b/etc/profile.d/00_profile.sh
index d2fb049..6deb862 100644
--- a/etc/profile.d/00_profile.sh
+++ b/etc/profile.d/00_profile.sh
@@ -27,7 +27,7 @@
 # ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
 # POSSIBILITY OF SUCH DAMAGE
 
-if [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTiON" ]; then
+if [ -n "$SSH_TTY" ] || [ -n "$SSH_CONNECTION" ]; then
 	export PS1='remote rescueshell \w \# '
 	touch /remote-rescueshell.lock
 	. /functions.sh
