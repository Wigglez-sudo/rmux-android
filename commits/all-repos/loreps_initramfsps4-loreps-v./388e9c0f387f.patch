From 388e9c0f387f3dd0b7f262649717e46d885d6c02 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Mon, 12 Oct 2026 11:12:36 +0200
Subject: [PATCH] install-linux-int: confirm before erasing and check the input

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 bin/install-linux-int.sh | 144 +++++++++++++++++++--------------------
 1 file changed, 72 insertions(+), 72 deletions(-)

diff --git a/bin/install-linux-int.sh b/bin/install-linux-int.sh
index adbd041..9fc13c9 100644
--- a/bin/install-linux-int.sh
+++ b/bin/install-linux-int.sh
@@ -1,97 +1,97 @@
 #!/bin/sh
 . /functions.sh
 
-# Prompt user for installation settings
-eask "Enter the amount of storage to dedicate to your Linux install (GB): "
-read seek_value
+boot=/ps4hdd/system/boot
+img=/ps4hdd/home/linux.img
 
-eask "Pick your file system (1 - ext4, 2 - btrfs): "
-read fs
-
-# Check decryption key
-if ! test -r /key/eap_hdd_key.bin; then
-    eerror "Error: decryption key does not exist or is not accessible."
-    exit 1
+if ! ps4hdd_open; then
+	eerror "Could not open the PS4 internal drive."
+	exit 1
 fi
 
-# Check physical device
-if ! test -b /dev/sda27; then
-    eerror "Error: /dev/sda27 device does not exist or is not accessible."
-    exit 1
+if [ -f "${boot}/psxitarch.tar.xz" ] && ! [ -f "${boot}/distro.tar.xz" ]; then
+	mv -f "${boot}/psxitarch.tar.xz" "${boot}/distro.tar.xz"
+	ewarn "psxitarch.tar.xz was renamed to distro.tar.xz. Use distro.tar.xz from now on."
 fi
 
-if ! test -r /ps4hdd/system/boot/psxitarch.tar.xz &&
-   ! test -r /ps4hdd/system/boot/distro.tar.xz; then
-    eerror "Distro file was not found."
-    exit 1
+if ! distro="$(ps4_find_distro "${boot}")"; then
+	eerror "No distro.tar.xz, distro.tar.gz or distro.tar.bz2 in ${boot}."
+	exit 1
 fi
 
-if ! mountpoint -q /ps4hdd; then
-    eerror "Error: failed to mount /dev/mapper/ps4hdd on /ps4hdd."
-    exit 1
+if mountpoint -q /newroot && ! umount /newroot; then
+	eerror "/newroot is busy, can not install."
+	exit 1
 fi
 
-# Rename legacy distro archive
-if test -r /ps4hdd/system/boot/psxitarch.tar.xz; then
-    mv -f /ps4hdd/system/boot/psxitarch.tar.xz \
-        /ps4hdd/system/boot/distro.tar.xz
-
-    ewarn "psxitarch.tar.xz was renamed to distro.tar.xz. Use distro.tar.xz from now on."
-    sleep 1
+if [ -e "${img}" ]; then
+	ewarn "${img} already exists. Installing again erases it."
+	eask "Type YES to erase it: "
+	read answer
+	if [ "${answer}" != 'YES' ]; then
+		eerror "Aborted."
+		exit 1
+	fi
+	rm -f "${img}"
 fi
 
-# Create installation image
-dd if=/dev/null \
-    of=/ps4hdd/home/linux.img \
-    bs=1073741824 seek="$seek_value"
-
-# Set up loop device
-losetup /dev/loop5 /ps4hdd/home/linux.img
+free_gb="$(df -Pk /ps4hdd | awk 'END { print int($4 / 1048576) }')"
+if [ "${free_gb}" -lt 1 ]; then
+	eerror "Less than 1 GB free on the internal drive."
+	exit 1
+fi
 
-# Create filesystem
-case "$fs" in
-    1)
-        mkfs.ext4 /dev/loop5
-        ;;
-    2)
-        mkfs.btrfs /dev/loop5
-        ;;
-    *)
-        eerror "I don't understand this file system choice."
-        exit 1
-        ;;
+eask "Enter the amount of storage to dedicate to your Linux install (1-${free_gb} GB): "
+read size
+case "${size}" in
+	''|*[!0-9]*)
+		eerror "'${size}' is not a number."
+		exit 1
+	;;
 esac
+if [ "${size}" -lt 1 ] || [ "${size}" -gt "${free_gb}" ]; then
+	eerror "Size must be between 1 and ${free_gb} GB."
+	exit 1
+fi
 
-# Mount installation image
-mount /dev/loop5 /newroot
+eask "Pick your file system (1 - ext4, 2 - btrfs): "
+read fs
+case "${fs}" in
+	1|2) ;;
+	*)
+		eerror "I don't understand this file system choice."
+		exit 1
+	;;
+esac
 
-if ! mountpoint -q /newroot; then
-    eerror "Error: failed to mount /dev/loop5 on /newroot."
-    exit 1
+if ! dd if=/dev/null of="${img}" bs=1048576 count=0 seek="$((size * 1024))" 2>/dev/null; then
+	eerror "Could not create ${img}."
+	exit 1
 fi
 
-# Extract distro with progress bar
-if test -r /ps4hdd/system/boot/distro.tar.xz; then
-    pv -pterb \
-        -s "$(stat -c %s /ps4hdd/system/boot/distro.tar.xz)" \
-        /ps4hdd/system/boot/distro.tar.xz |
-        (cd /newroot && tar -xJf -)
-
-    if test "$?" -ne 0; then
-        eerror "Error: distro extraction failed."
-        exit 1
-    fi
+case "${fs}" in
+	1) mkfs.ext4 -q -F -O ^orphan_file,^metadata_csum_seed "${img}" ;;
+	2) mkfs.btrfs -q -f "${img}" ;;
+esac
+if [ "$?" -ne 0 ]; then
+	eerror "Could not create the file system."
+	rm -f "${img}"
+	exit 1
+fi
 
-    einfo "--INSTALL COMPLETE--"
-    einfo "If you are reading this message, type: resume-boot a few times to boot into the distro."
-    einfo "If it fails, try running: fix-install.sh and resume-boot again."
+if ! mount "${img}" /newroot; then
+	eerror "Could not mount ${img} on /newroot."
+	exit 1
+fi
 
-    find-install.sh
-    sleep 1
-    fix-install.sh
-else
-    eerror "Error: distro.tar.xz does not exist or is not readable."
-    exit 1
+einfo "Extracting $(basename "${distro}"), do not turn off the PS4..."
+if ! ps4_extract "${distro}"; then
+	eerror "Distro extraction failed."
+	exit 1
 fi
+ps4_prepare_newroot
+sync
 
+einfo "--INSTALL COMPLETE--"
+einfo "Booting..."
 resume-boot
